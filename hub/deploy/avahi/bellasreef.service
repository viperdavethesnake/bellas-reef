<?xml version="1.0" standalone='no'?><!--*-nxml-*-->
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">

<!--
  Advertises the API as _bellasreef._tcp so clients can browse for it.

  A hostname A record is not enough: an app that only knows bellasreef.local
  cannot tell a reef controller from any other host with that name, and cannot
  learn the port. auth.md step 1 browses for this service type.

  Install to /etc/avahi/services/bellasreef.service on the host.

  The contracts= value below is not maintained by hand, and must not be.
  scripts/install-hub.sh installs this file as it is; scripts/check.sh fails
  if the value stops matching the bellasreef-contracts package. The literal
  here is the fallback for the manual `cp` in docs/host-setup.md — it sat at
  2.0.0 while the package was at 3.3.0, derived from nothing and tested by
  nothing, which is a client refusing a hub it could have talked to (or
  accepting one it could not) on step 1 of the pairing flow.
-->
<service-group>
  <name replace-wildcards="yes">Bella's Reef on %h</name>
  <service>
    <type>_bellasreef._tcp</type>
    <port>8000</port>
    <txt-record>api=/api/v1</txt-record>
    <txt-record>contracts=4.4.0</txt-record>
  </service>
</service-group>
