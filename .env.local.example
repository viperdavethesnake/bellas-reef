# Machine-specific integration endpoints, sourced by the pre-push hook so the
# local gate checks what CI checks. Copy to .env.local (gitignored) and adjust.
#
# Without these the integration suites skip — and a skip for a missing
# environment fails the gate, because "all checks passed" has to mean the same
# thing on every machine.
BELLASREEF_TEST_DATABASE_URL=postgresql+asyncpg://bellasreef:bellasreef@bellasreef.local:5432/bellasreef_test
BELLASREEF_TEST_NATS_URL=nats://bellasreef.local:4222
BELLASREEF_TEST_VM_URL=http://bellasreef.local:8428
BELLASREEF_ASSUME_CLOCK_TRUSTED=1

# PostgreSQL client tools for the backup/restore suite. Homebrew keeps libpq
# keg-only, so pg_dump exists but is not on PATH. Apple silicon: /opt/homebrew.
BELLASREEF_PG_BIN=/usr/local/opt/libpq/bin
