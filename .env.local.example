# Machine-specific integration endpoints. Copy to .env.local (gitignored).
#
# LOOPBACK ONLY. conftest.py refuses to start the suite against anything else,
# and that refusal is deliberate: these tests bind durable consumers, BR_CMD is
# a workqueue that permits one consumer per filter subject, and so pointing them
# at the hub means competing with the hub for its own slot. It cost ten hours of
# lost monitoring on 2026-08-10. See CLAUDE.md, "Environment boundary".
#
# Bring up ephemeral dev containers first, the same shape CI uses:
#
#   docker run -d --name br-dev-nats -p 127.0.0.1:4222:4222 -p 127.0.0.1:8222:8222 \
#     nats:2.10-alpine --jetstream --http_port=8222
#   docker run -d --name br-dev-pg -p 127.0.0.1:5432:5432 \
#     -e POSTGRES_USER=bellasreef -e POSTGRES_PASSWORD=bellasreef \
#     -e POSTGRES_DB=bellasreef_test postgres:17-alpine
#   docker run -d --name br-dev-vm -p 127.0.0.1:8428:8428 \
#     victoriametrics/victoria-metrics:v1.149.0
#
#   (cd db && BELLASREEF_DATABASE_URL=postgresql+asyncpg://bellasreef:bellasreef@localhost:5432/bellasreef_test \
#      uv run alembic upgrade head)
#
# Tear them down with: docker rm -f br-dev-nats br-dev-pg br-dev-vm
#
# No container runtime on this machine? Then these suites do not run here. Say
# so out loud and let CI check them:
#
#   BELLASREEF_ALLOW_ENV_SKIPS=1 ./scripts/check.sh

BELLASREEF_TEST_DATABASE_URL=postgresql+asyncpg://bellasreef:bellasreef@localhost:5432/bellasreef_test
BELLASREEF_TEST_NATS_URL=nats://localhost:4222
BELLASREEF_TEST_VM_URL=http://localhost:8428
BELLASREEF_ASSUME_CLOCK_TRUSTED=1

# PostgreSQL client tools for the backup/restore suite. Homebrew keeps libpq
# keg-only, so pg_dump exists but is not on PATH. Apple silicon: /opt/homebrew.
BELLASREEF_PG_BIN=/usr/local/opt/libpq/bin
