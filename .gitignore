# Reference clones — read-only source material, never part of our build.
reference/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local runtime state — never commit live tank data or secrets
*.db
*.sqlite3
.env
# hub/deploy/.env — the per-host secrets install-hub.sh writes
config.local.*

# OS / editor
.DS_Store
.vscode/
.idea/

# Scratch inputs and generated work products. Reference images, exports and
# one-off captures live here and must never enter history — this repo is
# AGPL-licensed and intended to be published, so anything committed is
# published with it, permanently.
#
# Note: this rule does not untrack files already committed. See below.
artifacts/
.env.local
