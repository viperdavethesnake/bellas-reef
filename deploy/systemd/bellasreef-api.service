[Unit]
Description=Bella's Reef api
Documentation=https://github.com/viperdavethesnake/bellas-reef

# This board has no RTC battery. After a power cut the clock is wrong until
# chrony catches up, and this process hosts the telemetry writer and stamps
# audit rows, neither of which should run against a clock it cannot believe.
After=time-sync.target network-online.target
Wants=time-sync.target network-online.target

[Service]
# Not Type=notify: uvicorn does not send sd_notify, and declaring notify
# without a notifier makes systemd wait for a readiness signal that never
# arrives and then kill the unit as failed-to-start. hardware-io and
# control-engine notify from inside their own supervisor loops; this one does
# not, so it says so.
Type=exec
Restart=always
RestartSec=2

# Do not give up on the only process the clients can reach.
StartLimitIntervalSec=0

User=david
Group=david
# No device groups. The API reaches hardware only through NATS.

WorkingDirectory=/home/david/bellasreef
ExecStart=/home/david/bellasreef/.venv/bin/uvicorn \
    bellasreef_api.app:create_app --factory --host 0.0.0.0 --port 8000

# Machine-specific configuration lives on the host, not in this file, so the
# unit stays the same on every hub. This one carries the database DSN, which
# contains a password — another reason it is not an Environment= line, since
# those are readable by any user via `systemctl show`.
EnvironmentFile=/etc/bellasreef/api.env

StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ProtectKernelLogs=yes

[Install]
WantedBy=multi-user.target
