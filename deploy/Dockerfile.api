# api — stateless HTTP front door.
#
# No device access. Clients reach the tank only through this.
#
# Build context is the repo root:
#   docker build -f deploy/Dockerfile.api .

FROM python:3.13-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# PostgreSQL client tools for `bellasreef backup` / `bellasreef restore`.
# Version 17 specifically, matching the server pinned in compose.yaml: pg_dump
# refuses to dump a server newer than itself, and bookworm's default is 15.
# PGDG is the only place a 17 client comes from on this base image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] \
https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-17 \
    && apt-get purge -y --auto-remove gnupg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY contracts/python /app/contracts/python
COPY services/shared /app/services/shared
COPY db /app/db
COPY services/api /app/services/api

RUN uv pip install --system --no-cache \
        /app/contracts/python \
        /app/services/shared \
        /app/db \
        /app/services/api

RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin bellasreef
USER 1000:1000

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=4).status==200 else 1)"]

CMD ["uvicorn", "bellasreef_api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
