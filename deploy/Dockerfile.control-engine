# control-engine — control loops, scheduling, sole command publisher.
#
# No device access, ever. It reaches hardware only through NATS.
#
# Build context is the repo root:
#   docker build -f deploy/Dockerfile.control-engine .

FROM python:3.13-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY contracts/python /app/contracts/python
COPY services/shared /app/services/shared
COPY db /app/db
COPY services/control_engine /app/services/control_engine

RUN uv pip install --system --no-cache \
        /app/contracts/python \
        /app/services/shared \
        /app/db \
        /app/services/control_engine

RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin bellasreef
USER 1000:1000

EXPOSE 9102

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:9102/healthz', timeout=4).status==200 else 1)"]

CMD ["python", "-m", "bellasreef_control_engine.app"]
