# Shared base for every Python service.
#
# Exists in session 1 so CI proves the multi-arch build pipeline works before
# there is any service to build. Services extend this image.

FROM python:3.13-slim-bookworm

# uv from the official distroless image — no curl|sh, no pip bootstrap.
COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Contracts are the only dependency every service shares.
COPY contracts/python /app/contracts/python
RUN uv pip install --system --no-cache /app/contracts/python

# Nothing runs as root.
RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin bellasreef
USER 1000:1000

CMD ["python", "-c", "import bellasreef_contracts as c; print('contracts', c.SCHEMA_VERSION)"]
