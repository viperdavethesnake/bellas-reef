# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- Postgres ----
POSTGRES_USER=bellasreef
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bellasreef

# Consumed by Alembic and the services. Must use the asyncpg driver.
BELLASREEF_DATABASE_URL=postgresql+asyncpg://bellasreef:change-me@postgres:5432/bellasreef

# ---- Spine ----
NATS_URL=nats://nats:4222

# ---- Time-series ----
# VictoriaMetrics retention, in months.
VM_RETENTION=24

# ---- Hardware access (hardware-io only) ----
# Host group IDs, so the container reaches /dev/i2c-1 and /dev/gpiochip0
# without running as root. Find them on the Pi with:
#   getent group i2c gpio
I2C_GID=994
GPIO_GID=993
