# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- Postgres ----
POSTGRES_USER=bellasreef
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bellasreef

# Consumed by Alembic and the services. Must use the asyncpg driver.
BELLASREEF_DATABASE_URL=postgresql+asyncpg://bellasreef:change-me@postgres:5432/bellasreef

# ---- Spine ----
NATS_URL=nats://nats:4222

# ---- App images ----
# Which build of hardware-io/control-engine/api to run. deploy-pi.sh exports
# BELLASREEF_TAG=<sha> for the duration of a deploy and rewrites this line to
# match once the deploy succeeds, so a boot picks up the last thing actually
# deployed rather than silently drifting to whatever :latest resolves to.
BELLASREEF_TAG=latest

# ---- Time-series ----
# VictoriaMetrics retention, in months.
VM_RETENTION=24

# ---- Hardware access (hardware-io only) ----
# Host group IDs, so the container reaches /dev/i2c-1 and /dev/gpiochip0
# without running as root. Find them on the Pi with:
#   getent group i2c gpio
I2C_GID=994
GPIO_GID=993
