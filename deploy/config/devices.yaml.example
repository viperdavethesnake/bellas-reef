# A device file for `bellasreef devices import`. Copy, edit, import.
#
# **This file does not drive hardware-io.** It used to, and that is exactly why
# it no longer does: it let a config author choose an id for hardware that
# already had one in the registry, and a tank's history forked across two
# device_ids for seventy minutes.
#
# The registry is the source of device topology now. Hardware announces what it
# can offer, an operator binds a channel to a device, and hardware-io builds
# from those assignments. This file is a convenience for seeding a bench hub and
# for restoring one from notes — nothing more. Importing it goes through
# POST /api/v1/devices with the same validation as any client, including the
# rule that hardware already in the registry is adopted rather than duplicated.
#
#   bellasreef devices import devices.yaml --api http://bellasreef.local:8000
#
# It needs a credential, because it is a client like any other:
# --token, or $BELLASREEF_TOKEN.
#
# Two rules worth knowing before you edit:
#
#   `id` is identity. It is the NATS subject token, the row in the devices
#   table, the name on the phone, and the key its history is stored under.
#   Proposing a new id for hardware the registry already knows renames nothing
#   and creates nothing — the import adopts what is there.
#
#   Unknown keys are refused rather than ignored. `chanel: 1` is an error, not a
#   silent fallback to channel 0.

version: 1

actuators:
  # David's build: two LED channels on the Pi's own hardware PWM.
  #
  # `channel` is the pwmchip channel, not a GPIO number. GPIO12 is channel 0 and
  # GPIO13 is channel 1, set by the PWM overlay — see docs/host-setup.md §9.
  #
  # `inverted` follows the output stage and is set from bench measurement, not
  # from reasoning. Leave it false until a meter says otherwise.
  - id: led-blue
    role: light
    binding:
      driver: pi-pwm
      channel: 0
      inverted: false

  - id: led-white
    role: light
    binding:
      driver: pi-pwm
      channel: 1
      inverted: false

  # The many-channel option, for a hub that outgrows two. Same contract, same
  # safety registration, invisible to everything above hardware-io — the only
  # thing that changes upward is `driver_id`.
  #
  # BENCH-BLOCKED: the PCA9685 driver has never driven a real light. Do not
  # uncomment on a hub wired to lights until the bench session passes.
  #
  # - id: led-red
  #   role: light
  #   binding:
  #     driver: pca9685
  #     channel: 0
  #     bus: 1
  #     address: 0x40

sensors:
  # Probes are addressed by ROM code — the probe's own identity, burned in at
  # manufacture, so it survives being moved to another port on the bus. The ROM
  # is deliberately not the device id: replacing a failed probe should change
  # one line here rather than rewrite the history of the tank.
  #
  # Find them with: ls /sys/bus/w1/devices/ | grep '^28-'
  - id: display-tank
    binding:
      driver: ds18b20
      rom: 28-000000bfe244
      poll_interval_s: 5.0

  # Declare a probe before it is wired and the hub knows it is missing: the
  # silence watcher raises an alert for a declared probe that never reports,
  # where an undiscovered one is simply invisible. That is the difference
  # between "no second probe" and "the second probe fell off the bus".
  #
  # - id: sump
  #   binding:
  #     driver: ds18b20
  #     rom: 28-0000010c4d91
