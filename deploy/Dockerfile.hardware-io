# hardware-io — the only container with device access.
#
# Build context is the repo root:
#   docker build -f deploy/Dockerfile.hardware-io .

# pinctrl reads the live pin mux (capabilities.py's discovery announces only
# what the mux proves) but ships in no Debian package — it is a raspberrypi/utils
# source tool, built here from a pinned commit. A moving HEAD is not a build
# input: re-resolve deliberately with
#   git ls-remote https://github.com/raspberrypi/utils HEAD
# and update the pin below, rather than tracking the branch.
FROM debian:bookworm-slim AS pinctrl-build
# ca-certificates: without it, git's HTTPS clone of github.com fails with
# "server certificate verification failed. CAfile: none" — debian:bookworm-slim
# carries no trust store by default, and cloning over https needs one.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates cmake gcc make libc6-dev && rm -rf /var/lib/apt/lists/*
# Pinned 2026-08-13 via the ls-remote command above.
RUN git clone https://github.com/raspberrypi/utils /src \
    && cd /src && git checkout 6609ecb54f233d372d76b00caa12b292a6a9dba1 \
    && cd pinctrl && cmake . && make

FROM python:3.13-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY contracts/python /app/contracts/python
COPY services/shared /app/services/shared
COPY services/hardware_io /app/services/hardware_io

RUN uv pip install --system --no-cache \
        /app/contracts/python \
        /app/services/shared \
        /app/services/hardware_io

# capabilities.py invokes this by the absolute path PINCTRL == "/usr/bin/pinctrl".
COPY --from=pinctrl-build /src/pinctrl/pinctrl /usr/bin/pinctrl

# Nothing runs as root. The compose file adds the host's gpio/i2c GIDs so this
# user can reach /dev/i2c-1 and /dev/gpiochip0 without privileges.
RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin bellasreef
USER 1000:1000

EXPOSE 9101

# No curl in the slim image, and adding it to widen the attack surface of the
# one container holding /dev would be a poor trade. /healthz reports real state:
# it returns 503 on a stalled loop or an untrusted clock.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:9101/healthz', timeout=4).status==200 else 1)"]

CMD ["python", "-m", "bellasreef_hardware_io.app"]
